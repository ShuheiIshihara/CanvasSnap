<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CanvasSnap.App"
             xmlns:local="using:CanvasSnap"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
    </Application.Styles>

    <!-- システムトレイアイコン設定 (Requirement 9.1-9.5) -->
    <TrayIcon.Icons>
        <TrayIcons>
            <TrayIcon Icon="/Assets/canvassnap.ico" ToolTipText="CanvasSnap">
                <TrayIcon.Menu>
                    <NativeMenu>
                        <NativeMenuItem Header="設定" Click="OnShowSettings" />
                        <NativeMenuItemSeparator />
                        <NativeMenuItem Header="終了" Click="OnExit" />
                    </NativeMenu>
                </TrayIcon.Menu>
            </TrayIcon>
        </TrayIcons>
    </TrayIcon.Icons>
</Application>